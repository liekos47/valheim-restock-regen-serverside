<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>RestockRegen</AssemblyName>
    <RootNamespace>RestockRegen</RootNamespace>
    <Version>0.18.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <!-- ScriptEngine (hot reload) reads symbols when it loads a plugin; embedded, the DLL is the only file to ship. -->
    <DebugType>embedded</DebugType>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Points VALHEIM_DEDI_INSTALL at a dedicated-server layout (valheim_server_Data\Managed + BepInEx\core). Not committed. -->
  <Import Project="Environment.props" Condition="Exists('Environment.props')" />

  <!-- Only src\ is the mod. tools\ holds separate projects; the rest is local reference material. -->
  <ItemGroup>
    <Compile Remove="tools\**;upstream\**;refs\**;worldcopy\**;pkg\**" />
    <None Remove="tools\**;upstream\**;refs\**;worldcopy\**;pkg\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.1" PrivateAssets="all" />
    <Reference Include="assembly_valheim" Publicize="true">
      <HintPath>$(VALHEIM_DEDI_INSTALL)\valheim_server_Data\Managed\assembly_valheim.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(VALHEIM_DEDI_INSTALL)\valheim_server_Data\Managed\assembly_utils.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(VALHEIM_DEDI_INSTALL)\valheim_server_Data\Managed\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(VALHEIM_DEDI_INSTALL)\valheim_server_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(VALHEIM_DEDI_INSTALL)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(VALHEIM_DEDI_INSTALL)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Thunderstore package: pkg\ holds manifest, icon, README, CHANGELOG and plugins\RestockRegen.dll,
       zipped to RestockRegen-<version>.zip. The icon is optional until the name is final. -->
  <Target Name="Package" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <MakeDir Directories="$(MSBuildProjectDirectory)\pkg\plugins" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)\pkg\plugins" />
    <Copy SourceFiles="manifest.json;README.md;CHANGELOG.md" DestinationFolder="$(MSBuildProjectDirectory)\pkg" />
    <Copy SourceFiles="icon.png" DestinationFolder="$(MSBuildProjectDirectory)\pkg" Condition="Exists('icon.png')" />
    <ZipDirectory SourceDirectory="$(MSBuildProjectDirectory)\pkg" DestinationFile="$(MSBuildProjectDirectory)\RestockRegen-$(Version).zip" Overwrite="true" />
  </Target>

</Project>
